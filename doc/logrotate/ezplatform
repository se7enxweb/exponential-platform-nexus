# logrotate example for the 1.0.0.x line (the 2.5 generation, Symfony 3.4: branches master and 1.0.0.x).
#
# Copy it to /etc/logrotate.d/<site>, then replace the path and the user. The path below matches every
# project under /var/www/html/; name your own project directory instead.
#
# Symfony writes var/logs/<environment>.log: prod.log in production, dev.log and test.log in the other
# environments (the monolog handler of app/config writes %log_path%; LOG_PATH and LOG_TYPE can move it).
# Files you add yourself there, such as a cron.log, are rotated as well.
#
# copytruncate keeps the files that PHP-FPM workers and Exponential Velocity's persistent workers hold open
# valid without a reload. A few lines written during the copy can be lost; if that matters, drop
# copytruncate and reload PHP-FPM or Velocity in a postrotate script instead.
#
# su is needed because var/logs/ is writable by the web server's user, not only by root; without it
# logrotate refuses to rotate ("insecure permissions"). Use the user and group that run PHP.
#
# The legacy kernel's own logs (ezpublish_legacy/var/log/*.log and ezpublish_legacy/var/<site>/log/*.log)
# are rotated by the legacy kernel itself when they reach their size limit; leave them out of logrotate.
#
# Check a change without rotating anything: logrotate -d /etc/logrotate.d/<site>
/var/www/html/*/var/logs/*.log {
    daily
    rotate 14
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su www-data www-data
}
